{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",          // ① 改成了 g++（C++ 编译器）
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",                  // ② 指定 C++ 标准
                "-I", "${workspaceFolder}/include",
                "-pthread",                    // ③ 链接 pthread 多线程库
                "-no-pie",                     // ④ 关键！关闭 PIE 安全检查，解决你的报错
                "-g",                          // 调试信息
                "${file}",                     // 当前文件
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"  // 输出可执行文件
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cmake",
            "label": "CMake: 配置",
            "command": "configure",
            "problemMatcher": [],
            "detail": "CMake 模板 配置 任务"
        }
    ]
}